#!/bin/sh
# Pre-commit hook to verify Java code formatting with Spotless

# Only run if staged files include .java files
if git diff --cached --name-only | grep -E '\.java$' > /dev/null 2>&1; then
    echo "🔍 Checking Java code formatting with Spotless..."
    mvn -B spotless:check
    status=$?
    if [ $status -ne 0 ]; then
        echo ""
        echo "❌ Spotless format check failed!"
        echo "👉 Run 'mvn spotless:apply' to format your code, then re-stage and commit."
        echo ""
        exit 1
    fi
fi
